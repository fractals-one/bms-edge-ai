# ==============================================================================
# .gitignore for STSW-L9961BMS
# Excludes ST proprietary code that cannot be publicly redistributed (SLA0104)
# Users must obtain these separately from st.com
# ==============================================================================

# --- ST Proprietary (SLA0104 / restricted redistribution) ---
firmware/Middlewares/
firmware/AI/
firmware/Drivers/STM32G0xx_HAL_Driver/
firmware/Drivers/CMSIS/

# --- Pre-built binaries ---
firmware/Bin/

# --- IDE-specific build artifacts ---
firmware/STM32CubeIDE/Debug/
firmware/STM32CubeIDE/Release/
firmware/STM32CubeIDE/STSW-L9961BMS_DemoAI/
firmware/STM32CubeIDE/STSW-L9961BMS_Demo1/
firmware/STM32CubeIDE/STSW-L9961BMS_Demo2/
firmware/STM32CubeIDE/STSW-L9961BMS_Demo3/
firmware/STM32CubeIDE/STSW-L9961BMS_Demo4/
firmware/STM32CubeIDE/.settings/
firmware/EWARM/Debug/
firmware/EWARM/Release/
firmware/EWARM/settings/
firmware/MDK-ARM/Objects/
firmware/MDK-ARM/Listings/
firmware/.metadata/

# --- Build outputs ---
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.list
*.su

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
